# Environment Variables Example

# DSH Configuration
NODE_ENV=production
DSH_HOME=/data
DSH_TELEMETRY_DISABLED=1
DSH_PERMISSION_MODE=workspace-write

# Application
PORT=3000
PUBLIC_URL=https://dsh.kcb.ma/

# Cloudflare Access (configured externally, not stored in Docker)
# Configured as an external reverse-proxy layer, not inside this container

# OpenRouter (configured via DSH Web UI, not in Dockerfile)
# DEEPSEEK_API_KEY, etc. - not set in Docker, configured post-deployment